# Supabase Postgres (use the "Connection string" / DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_SUPABASE_HOST:6543/postgres?schema=public"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# CORS
WEB_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-16chars-min"
JWT_REFRESH_SECRET="change-me-refresh-16chars-min"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

# Cookies
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# Seed admin (optional)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

