# MySQL (local phpMyAdmin in dev, Hostinger MySQL in prod). No ORM.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="designs_crm"
DB_CONNECTION_LIMIT="10"

# CORS - the Vite SPA origin
WEB_ORIGIN="http://localhost:5173"

# Auth
JWT_ACCESS_SECRET="change-me-access-16chars-min"
JWT_REFRESH_SECRET="change-me-refresh-16chars-min"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

# Cookies
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# Seed admin (optional; created on boot if not present)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Local-only: return resetToken from forgot-password when SMTP is not configured.
# Keep false for demos/shared environments.
AUTH_EXPOSE_RESET_TOKEN="false"

# Local disk file storage
UPLOAD_DIR="uploads"
STORAGE_SIGNED_URL_TTL_SECONDS="600"
# Optional dedicated secret for signing download URLs (defaults to JWT_ACCESS_SECRET)
STORAGE_URL_SECRET=""
